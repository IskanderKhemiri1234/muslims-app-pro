<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/mumin_countdown_notification_bg">

    <TextView
        android:id="@+id/mumin_countdown_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الصلاة القادمة"
        android:textColor="#E8CE91"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/mumin_countdown_prayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="#FFFFFCF5"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <Chronometer
        android:id="@+id/mumin_countdown_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:format="%s"
        android:textColor="#E8CE91"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        android:gravity="start"
        android:contentDescription="Countdown to next prayer" />
</LinearLayout>