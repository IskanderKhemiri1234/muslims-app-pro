<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@drawable/mumin_countdown_notification_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mumin_countdown_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mumin Pro"
            android:textColor="#E8CE91"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/mumin_countdown_prayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#FFFFFCF5"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="34dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#55D8B66A" />

    <Chronometer
        android:id="@+id/mumin_countdown_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format="%s"
        android:textColor="#E8CE91"
        android:textSize="23sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        android:gravity="center"
        android:contentDescription="Time remaining until next prayer" />
</LinearLayout>